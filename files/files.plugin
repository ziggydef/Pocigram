from base_plugin import BasePlugin, MethodHook
from client_utils import get_last_fragment
from ui.alert import AlertDialogBuilder
from hook_utils import find_class
from ui.bulletin import BulletinHelper
from ui.settings import Text, Input, Switch
from android_utils import copy_to_clipboard
from file_utils import get_cache_dir
from java.lang import String, Throwable
from java.io import File
from android.content import Intent, ClipData
from androidx.core.content import FileProvider

from collections import deque
from datetime import datetime
import os
import threading

__id__ = "log-viewer"
__name__ = "Log Viewer"
__description__ = "Collect, view, copy and export application logs"
__author__ = "@PESSDES"
__min_version__ = "11.12.0"
__icon__ = "FluentEmoji5/28"
__version__ = "2.0"

MAX_DEFAULT = 100
MAX_ALLOWED = 5000

max_len = MAX_DEFAULT
logs = deque(maxlen=MAX_DEFAULT)
logs_lock = threading.RLock()


class Localization:
    strings = {
        "ru": {
            "APP_UTILS_CLASS_NOT_FOUND": "Класс AppUtils не найден",
            "LOG_INTERNAL_METHOD_NOT_FOUND": "Метод logInternal не найден",
            "HOOK_FAILED": "Не удалось установить перехват",
            "SHOW_LOGS": "Показать логи",
            "MAX_LOGS": "Максимальное количество логов",
            "MAX_LOGS_SUBTEXT": "Максимальное количество записей (1–5000)",
            "SHOW_DATE": "Показывать дату и время",
            "CLEAR_LOGS": "Очистить буфер логов",
            "COPY_LOGS": "Скопировать все логи",
            "EXPORT_LOGS": "Отправить все логи (.txt)",
            "EMPTY": "Буфер логов пуст",
            "COPIED": "Все логи скопированы",
            "EXPORTED": "Файл логов подготовлен",
            "EXPORT_ERROR": "Ошибка экспорта",
            "VIEW_TITLE": "Log Viewer",
            "LOADED": "Плагин успешно загружен",
        },
        "en": {
            "APP_UTILS_CLASS_NOT_FOUND": "AppUtils class not found",
            "LOG_INTERNAL_METHOD_NOT_FOUND": "logInternal method not found",
            "HOOK_FAILED": "Failed to install hook",
            "SHOW_LOGS": "View logs",
            "MAX_LOGS": "Maximum logs count",
            "MAX_LOGS_SUBTEXT": "Maximum entries (1–5000)",
            "SHOW_DATE": "Show date and time",
            "CLEAR_LOGS": "Clear logs buffer",
            "COPY_LOGS": "Copy all logs",
            "EXPORT_LOGS": "Export all logs (.txt)",
            "EMPTY": "Log buffer is empty",
            "COPIED": "All logs copied",
            "EXPORTED": "Log file prepared",
            "EXPORT_ERROR": "Export error",
            "VIEW_TITLE": "Log Viewer",
            "LOADED": "Plugin successfully loaded",
        }
    }

    def __init__(self):
        from java.util import Locale
        language = Locale.getDefault().getLanguage()
        self.language = language if language in self.strings else "en"

    def __getitem__(self, key):
        return self.strings[self.language].get(
            key, self.strings["en"].get(key, key)
        )


strings = Localization()


def get_logs_text(show_date=True):
    with logs_lock:
        snapshot = list(logs)

    if not snapshot:
        return ""

    result = []
    for entry in snapshot:
        if show_date:
            result.append(f"[{entry.date}] {entry.message}")
        else:
            result.append(entry.message)

    return "\n".join(result)


class Log:
    def __init__(self, message):
        self.message = str(message)
        self.date = datetime.now().strftime("%Y-%m-%d %H:%M:%S")


class LogHooker(MethodHook):
    def before_hooked_method(self, param):
        try:
            message = param.args[0]
            if message is None:
                message = "null"

            with logs_lock:
                logs.append(Log(message))
        except Exception:
            pass


class LogViewerPlugin(BasePlugin):
    def on_plugin_load(self):
        global max_len, logs

        try:
            saved_limit = int(self.get_setting("max_len", MAX_DEFAULT))
            max_len = max(1, min(saved_limit, MAX_ALLOWED))
            with logs_lock:
                logs = deque(logs, maxlen=max_len)
        except Exception:
            max_len = MAX_DEFAULT
            logs = deque(maxlen=MAX_DEFAULT)

        AppUtils = find_class(
            "com.exteragram.messenger.utils.AppUtils"
        )

        if not AppUtils:
            error = strings["APP_UTILS_CLASS_NOT_FOUND"]
            self.log(error)
            BulletinHelper.show_error(error)
            return

        try:
            IntegerType = find_class("java.lang.Integer").TYPE
            method_to_hook = AppUtils.getDeclaredMethod(
                "logInternal", String, Throwable, IntegerType
            )
            method_to_hook.setAccessible(True)
        except Exception as e:
            error = strings["LOG_INTERNAL_METHOD_NOT_FOUND"]
            self.log(f"{error}: {e}")
            BulletinHelper.show_error(error)
            return

        try:
            handler = LogHooker()
            unhook_obj = self.hook_method(method_to_hook, handler, 10)

            if not unhook_obj:
                error = strings["HOOK_FAILED"]
                self.log(error)
                BulletinHelper.show_error(error)
                return

            self.log(strings["LOADED"])
        except Exception as e:
            self.log(f"{strings['HOOK_FAILED']}: {e}")
            BulletinHelper.show_error(strings["HOOK_FAILED"])

    def create_settings(self):
        with logs_lock:
            count = len(logs)
            limit = logs.maxlen

        return [
            Text(
                text=f"{strings['SHOW_LOGS']} ({count}/{limit})",
                icon="filled_views",
                on_click=self.show_logs
            ),
            Text(
                text=strings["COPY_LOGS"],
                icon="msg_copy",
                on_click=self.copy_logs
            ),
            Text(
                text=strings["EXPORT_LOGS"],
                icon="msg_document",
                on_click=self.export_logs
            ),
            Input(
                key="max_len",
                text=strings["MAX_LOGS"],
                default=str(max_len),
                subtext=strings["MAX_LOGS_SUBTEXT"],
                on_change=self.on_maxlen_change
            ),
            Switch(
                key="show_date",
                text=strings["SHOW_DATE"],
                default=True,
                icon="input_calendar1"
            ),
            Text(
                text=strings["CLEAR_LOGS"],
                icon="msg_clearcache",
                red=True,
                on_click=self.clear_logs
            )
        ]

    def on_maxlen_change(self, value: str):
        global max_len, logs

        try:
            new_limit = int(value)
            if new_limit < 1 or new_limit > MAX_ALLOWED:
                raise ValueError("Invalid limit")

            with logs_lock:
                max_len = new_limit
                logs = deque(logs, maxlen=max_len)

            self.set_setting("max_len", str(max_len))
        except Exception:
            self.set_setting("max_len", str(max_len))
            BulletinHelper.show_error(strings["MAX_LOGS_SUBTEXT"])

    def show_logs(self, view):
        text = get_logs_text(self.get_setting("show_date", True))

        if not text:
            BulletinHelper.show_info(strings["EMPTY"])
            return

        fragment = get_last_fragment()
        if not fragment:
            return

        activity = fragment.getParentActivity()
        if not activity:
            return

        builder = AlertDialogBuilder(
            activity,
            AlertDialogBuilder.ALERT_TYPE_MESSAGE
        )
        builder.set_title(strings["VIEW_TITLE"])
        builder.set_message(text)
        builder.set_positive_button(
            strings["COPY_LOGS"],
            lambda dialog, which: self.copy_logs(None)
        )
        builder.set_negative_button("OK", lambda dialog, which: dialog.dismiss())
        builder.show()

    def copy_logs(self, view):
        text = get_logs_text(self.get_setting("show_date", True))

        if not text:
            BulletinHelper.show_info(strings["EMPTY"])
            return

        try:
            copy_to_clipboard(text)
            BulletinHelper.show_success(strings["COPIED"])
        except Exception as e:
            self.log(f"Clipboard error: {e}")
            BulletinHelper.show_error("Clipboard error")

    def export_logs(self, view):
        text = get_logs_text(self.get_setting("show_date", True))

        if not text:
            BulletinHelper.show_info(strings["EMPTY"])
            return

        try:
            fragment = get_last_fragment()
            if not fragment:
                raise Exception("No active fragment")

            activity = fragment.getParentActivity()
            if not activity:
                raise Exception("No activity")

            cache_dir = get_cache_dir()
            export_dir = os.path.join(str(cache_dir), "log_viewer")
            os.makedirs(export_dir, exist_ok=True)

            filename = (
                "LogViewer_"
                + datetime.now().strftime("%Y%m%d_%H%M%S")
                + ".txt"
            )
            file_path = os.path.join(export_dir, filename)

            with open(file_path, "w", encoding="utf-8") as file:
                file.write(text)

            java_file = File(file_path)
            authority = str(activity.getPackageName()) + ".provider"
            uri = FileProvider.getUriForFile(
                activity, authority, java_file
            )

            send_intent = Intent(Intent.ACTION_SEND)
            send_intent.setType("text/plain")
            send_intent.putExtra(Intent.EXTRA_STREAM, uri)
            send_intent.putExtra(Intent.EXTRA_SUBJECT, "Log Viewer export")
            send_intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            send_intent.setClipData(
                ClipData.newUri(
                    activity.getContentResolver(), filename, uri
                )
            )

            chooser = Intent.createChooser(
                send_intent, strings["EXPORT_LOGS"]
            )
            activity.startActivity(chooser)
            BulletinHelper.show_success(strings["EXPORTED"])

        except Exception as e:
            self.log(f"{strings['EXPORT_ERROR']}: {e}")
            BulletinHelper.show_error(
                f"{strings['EXPORT_ERROR']}: {e}"
            )

    def clear_logs(self, view):
        with logs_lock:
            logs.clear()

        BulletinHelper.show_success(strings["CLEAR_LOGS"])
